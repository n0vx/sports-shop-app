# Скопируйте в .env и поправьте. Файл .env в Git не попадает.
SPORT_STORE_MYSQL_HOST=127.0.0.1
SPORT_STORE_MYSQL_PORT=3306
SPORT_STORE_MYSQL_USER=sport_store
SPORT_STORE_MYSQL_PASSWORD=sport_store_pass
SPORT_STORE_MYSQL_DATABASE=sport_store

# Ключ подписи cookie. Если не задан, создаётся и хранится в instance/secret_key
# SECRET_KEY=

# За HTTPS-прокси (nginx и т.п.):
# SPORT_STORE_HTTPS=1
# SPORT_STORE_PROXY=1

# Запуск через run.py
# HOST=127.0.0.1
# PORT=5000
